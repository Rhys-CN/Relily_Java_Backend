<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.relily.system.mapper.CosmeticsAppointmentMapper">
    
    <resultMap type="CosmeticsAppointment" id="CosmeticsAppointmentResult">
        <result property="id"            column="id"                />
        <result property="orderNo"       column="order_no"          />
        <result property="userId"        column="user_id"           />
        <result property="userName"      column="user_name"         />
        <result property="goodsId"       column="goods_id"          />
        <result property="goodsName"     column="goods_name"        />
        <result property="sellerId"      column="seller_id"         />
        <result property="unitPrice"     column="unit_price"        />
        <result property="quantity"      column="quantity"          />
        <result property="totalAmount"   column="total_amount"      />
        <result property="appointTime"   column="appoint_time"      />
        <result property="expireTime"    column="expire_time"       />
        <result property="contactPhone"  column="contact_phone"     />
        <result property="receiverName"  column="receiver_name"     />
        <result property="receiverPhone" column="receiver_phone"    />
        <result property="receiverAddr"  column="receiver_addr"     />
        <result property="status"        column="status"            />
        <result property="cancelReason"  column="cancel_reason"     />
        <result property="cancelTime"    column="cancel_time"       />
        <result property="finishTime"    column="finish_time"       />
        <result property="expressCompany" column="express_company"  />
        <result property="expressNo"     column="express_no"        />
        <result property="shipTime"      column="ship_time"         />
        <result property="delFlag"       column="del_flag"          />
        <result property="createBy"      column="create_by"         />
        <result property="createTime"    column="create_time"       />
        <result property="updateBy"      column="update_by"         />
        <result property="updateTime"    column="update_time"       />
        <result property="remark"        column="remark"            />
    </resultMap>

    <sql id="selectCosmeticsAppointmentVo">
        select id, order_no, user_id, user_name, goods_id, goods_name, seller_id,
               unit_price, quantity, total_amount, appoint_time, expire_time,
               contact_phone, receiver_name, receiver_phone, receiver_addr,
               status, cancel_reason, cancel_time, finish_time,
               express_company, express_no, ship_time, del_flag,
               create_by, create_time, update_by, update_time, remark
        from cosmetics_appointment
    </sql>

    <select id="selectCosmeticsAppointmentById" parameterType="Long" resultMap="CosmeticsAppointmentResult">
        <include refid="selectCosmeticsAppointmentVo"/>
        where id = #{id}
    </select>

    <select id="selectCosmeticsAppointmentByOrderNo" parameterType="String" resultMap="CosmeticsAppointmentResult">
        <include refid="selectCosmeticsAppointmentVo"/>
        where order_no = #{orderNo}
    </select>

    <select id="selectCosmeticsAppointmentList" parameterType="CosmeticsAppointment" resultMap="CosmeticsAppointmentResult">
        <include refid="selectCosmeticsAppointmentVo"/>
        <where>
            del_flag = '0'
            <if test="orderNo != null and orderNo != ''"> AND order_no = #{orderNo}</if>
            <if test="userId != null"> AND user_id = #{userId}</if>
            <if test="sellerId != null"> AND seller_id = #{sellerId}</if>
            <if test="goodsId != null"> AND goods_id = #{goodsId}</if>
            <if test="goodsName != null and goodsName != ''"> AND goods_name like concat('%', #{goodsName}, '%')</if>
            <if test="status != null and status != ''"> AND status = #{status}</if>
            <if test="userName != null and userName != ''"> AND user_name like concat('%', #{userName}, '%')</if>
        </where>
        order by id desc
    </select>

    <select id="selectAppointmentListForSeller" parameterType="CosmeticsAppointment" resultMap="CosmeticsAppointmentResult">
        <include refid="selectCosmeticsAppointmentVo"/>
        <where>
            del_flag = '0'
            <if test="sellerId != null">
                AND seller_id = #{sellerId}
            </if>
            <if test="orderNo != null and orderNo != ''"> AND order_no = #{orderNo}</if>
            <if test="goodsName != null and goodsName != ''"> AND goods_name like concat('%', #{goodsName}, '%')</if>
            <if test="status != null and status != ''"> AND status = #{status}</if>
        </where>
        order by id desc
    </select>

    <insert id="insertCosmeticsAppointment" parameterType="CosmeticsAppointment" useGeneratedKeys="true" keyProperty="id">
        insert into cosmetics_appointment (
            order_no, user_id, user_name, goods_id, goods_name, seller_id,
            unit_price, quantity, total_amount, appoint_time, expire_time,
            contact_phone, receiver_name, receiver_phone, receiver_addr,
            status, del_flag, create_by, remark
        ) values (
            #{orderNo}, #{userId}, #{userName}, #{goodsId}, #{goodsName}, #{sellerId},
            #{unitPrice}, #{quantity}, #{totalAmount}, #{appointTime}, #{expireTime},
            #{contactPhone}, #{receiverName}, #{receiverPhone}, #{receiverAddr},
            #{status}, '0', <if test="createBy != null and createBy != ''">#{createBy},</if>
            #{remark}
        )
    </insert>

    <update id="updateCosmeticsAppointment" parameterType="CosmeticsAppointment">
        update cosmetics_appointment
        <set>
            <if test="quantity != null">quantity = #{quantity},</if>
            <if test="totalAmount != null">total_amount = #{totalAmount},</if>
            <if test="appointTime != null">appoint_time = #{appointTime},</if>
            <choose>
                <when test="expireTime != null">expire_time = #{expireTime},</when>
                <otherwise>expire_time = null,</otherwise>
            </choose>
            <if test="contactPhone != null">contact_phone = #{contactPhone},</if>
            <if test="receiverName != null">receiver_name = #{receiverName},</if>
            <if test="receiverPhone != null">receiver_phone = #{receiverPhone},</if>
            <if test="receiverAddr != null">receiver_addr = #{receiverAddr},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="cancelReason != null">cancel_reason = #{cancelReason},</if>
            <if test="cancelTime != null">cancel_time = #{cancelTime},</if>
            <if test="finishTime != null">finish_time = #{finishTime},</if>
            <if test="expressCompany != null">express_company = #{expressCompany},</if>
            <if test="expressNo != null">express_no = #{expressNo},</if>
            <if test="shipTime != null">ship_time = #{shipTime},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <update id="cancelAppointmentIfPending" parameterType="CosmeticsAppointment">
        update cosmetics_appointment
        set status = '2', cancel_reason = #{cancelReason}, cancel_time = #{cancelTime},
            update_by = #{updateBy}, update_time = sysdate()
        where id = #{id} and del_flag = '0'
        <choose>
            <when test="cancelReason == '超时自动取消'">
                and status = '0' and expire_time <![CDATA[ < ]]> #{cancelTime}
            </when>
            <otherwise>
                and status in ('0', '1')
            </otherwise>
        </choose>
    </update>

    <select id="selectExpiredAppointments" resultMap="CosmeticsAppointmentResult">
        <include refid="selectCosmeticsAppointmentVo"/>
        where status = '0' and expire_time <![CDATA[ < ]]> #{now} and del_flag = '0'
        order by id
        limit #{limit}
    </select>

    <update id="deleteCosmeticsAppointmentById" parameterType="Long">
        update cosmetics_appointment set del_flag = '1' where id = #{id}
    </update>

    <delete id="deleteCosmeticsAppointmentByIds" parameterType="Long">
        update cosmetics_appointment set del_flag = '1' where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
